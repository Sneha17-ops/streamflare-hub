{
  "name": "streamflare-hub",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "node -e \"const { spawn } = require('child_process'); spawn('next', ['dev'], { stdio: 'inherit', shell: true }); spawn('node', ['websocket-server.js'], { stdio: 'inherit', shell: true });\"",
    "prestart": "next build",
    "prepare": "husky install",
    "dev:3000": "next dev -p 3000",
    "build": "next build",
    "start": "next start",
    "lint": "next lint"
  },
  "dependencies": {
    "@clerk/nextjs": "^6.39.3",
    "@react-three/drei": "^9.122.0",
    "@react-three/fiber": "^9.0.0",
    "canvas-confetti": "^1.9.3",
    "clsx": "^2.1.1",
    "express": "^5.2.1",
    "framer-motion": "^11.11.0",
    "gsap": "^3.12.5",
    "ioredis": "^5.4.1",
    "lucide-react": "^0.453.0",
    "mongodb": "^6.9.0",
    "mongoose": "^8.7.1",
    "next": "^15.2.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^2.13.0",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.0",
    "tailwind-merge": "^2.5.4",
    "three": "^0.169.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "husky": "^8.0.0",
    "@types/canvas-confetti": "^1.6.4",
    "@types/node": "^20.14.9",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.169.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.5.2"
  },
  "overrides": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  }
}
